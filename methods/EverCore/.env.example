# Copy this file to .env and fill in credentials locally.
# Do not commit .env.

# Main answer-generation model.
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Optional DeepSeek-specific settings. Leave blank unless the corresponding
# official provider endpoint is intentionally configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Optional separate model used by graph/summary/atomic-fact ablations.
MEMORY_EXTRACT_API_KEY=
MEMORY_EXTRACT_BASE_URL=https://api.openai.com/v1

# Evaluator models used by the paper's benchmark conditions.
EVALUATE_MODEL=gpt-4o-mini-2024-07-18
MEMORYAGENTBENCH_EVALUATE_MODEL=gpt-4o-2024-11-20
MEME_EVALUATE_MODEL=gpt-4o-2024-11-20
PERSONAMEM_V2_JUDGE_MODEL=gpt-5-mini-2025-08-07

# Embedding service.
VECTORIZE_MODEL=text-embedding-3-small
VECTORIZE_API_KEY=
VECTORIZE_BASE_URL=https://api.openai.com/v1
# Used by local Mem0-style vector stores when a fixed dimension is required.
VECTORIZE_DIMS=1536

# Reranking service.
RERANK_API_KEY=
RERANK_MODEL=cohere/rerank-v3.5
RERANK_ENDPOINT=/rerank

# OpenAI's official API does not expose a /rerank endpoint. Keep this blank
# unless you configure a separate compatible reranker service directly.
RERANK_BASE_URL=

# Optional hosted memory-system credentials.
MEM0_API_KEY=
MEMOS_KEY=
MEMU_API_KEY=
ZEP_API_KEY=

# Optional local service endpoints.
MEMOS_LOCAL_URL=http://localhost:8000
MEMOS_LOCAL_KEY=
MEMORYOS_LOCAL_URL=http://localhost:8010
MEMORYOS_LOCAL_KEY=

# Model used by the EMem adapter.
EMEM_LLM_MODEL=gpt-4o-mini-2024-07-18
